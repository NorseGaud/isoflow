{
  "name": "isoflow",
  "version": "1.1.1",
  "private": false,
  "description": "An open-source React component for drawing network diagrams.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/markmanx/isoflow.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/Isoflow.d.ts",
  "scripts": {
    "start": "webpack serve --config ./webpack/dev.config.js",
    "start:server": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "start:all": "npm run start:server & npm run start",
    "start:mcp": "tsx --tsconfig mcp/tsconfig.json mcp/src/server.ts",
    "dev": "nodemon --watch ./src/ -e ts,tsx --exec npm run build",
    "build": "webpack --config ./webpack/prod.config.js && tsc --declaration --emitDeclarationOnly && tsc-alias",
    "test": "jest",
    "lint": "tsc --noEmit && eslint src --ext .ts,.tsx",
    "lint:fix": "eslint --fix src --ext .ts,.tsx",
    "docker:build": "webpack --config ./webpack/docker.config.js"
  },
  "devDependencies": {
    "@isoflow/isopacks": "^0.0.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chroma-js": "^3.1.2",
    "@types/cors": "^2.8.19",
    "@types/dom-to-image": "^2.6.7",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/pathfinding": "^0.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@types/supertest": "^7.2.1",
    "@types/webpack-env": "^1.18.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "css-loader": "^7.1.4",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.0",
    "style-loader": "^4.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^5.2.6"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "auto-bind": "^5.0.1",
    "chroma-js": "^3.2.0",
    "cors": "^2.8.6",
    "dom-to-image": "^2.6.0",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "gsap": "^3.15.0",
    "immer": "^11.1.15",
    "mui-color-input": "^9.0.0",
    "paper": "^0.12.18",
    "pathfinding": "^0.4.18",
    "playwright": "^1.61.1",
    "quill-delta": "^5.1.0",
    "react-hook-form": "^7.82.0",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.18.1",
    "sql.js": "^1.14.1",
    "uuid": "^11.1.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "overrides": {
    "shell-quote": "^1.10.0",
    "uuid": "^11.1.1",
    "quill": "2.0.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
